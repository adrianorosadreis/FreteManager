              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retorna quando o usuário é registrado com sucesso"
          },
          "400": {
            "description": "Retorna quando o modelo é inválido ou o email já está em uso",
            "content": {
